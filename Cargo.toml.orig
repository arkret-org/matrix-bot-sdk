[package]
name = "matrix-bot-sdk"
version = "0.2.4"
edition = "2024"
authors = ["Palpo Teams"]
license = "Apache-2.0"
description = "Rust SDK for Matrix bots and application services"
repository = "https://github.com/palpo-im/matrix-bot-sdk"
keywords = ["matrix", "bot", "sdk", "chat", "appservice"]
rust-version = "1.94"

[dependencies]
# Async runtime
tokio = { version = "1", features = ["full"] }

# HTTP client
reqwest = { version = "0.13", features = ["json", "stream"] }

# Serialization
serde = { version = "1", features = ["derive"] }
serde_json = "1"

# URL handling
url = { version = "2", features = ["serde"] }

# Encoding
base64 = "0.22"
percent-encoding = "2"

# Crypto (for E2EE)
sha2 = "0.10"
hmac = "0.12"
pbkdf2 = "0.12"
aes = "0.8"
cbc = "0.1"
rand = "0.10.0"

# Error handling
thiserror = "2"
anyhow = "1"

# Logging
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

# Async utilities
async-trait = "0.1"
futures = "0.3"
pin-project-lite = "0.2"

# Time
time = { version = "0.3", features = ["serde", "formatting", "parsing"] }
chrono = { version = "0.4", features = ["serde"] }

# Regex
regex = "1"
glob = "0.3"

# UUID
uuid = { version = "1", features = ["v4", "serde"] }

# Zeroize for secure memory handling
zeroize = "1"

# Optional: SQLite for storage
rusqlite = { version = "0.38", optional = true }

# Optional: PostgreSQL for storage
tokio-postgres = { version = "0.7", optional = true, features = [
    "with-serde_json-1",
] }

# Optional: Matrix SDK crypto integration (experimental)
# Note: matrix-sdk-crypto 0.14 has version conflicts with ruma 0.11
# Users who need full E2EE support should use matrix-sdk directly
# matrix-sdk-crypto = { version = "0.14", optional = true }
# vodozemac = { version = "0.9", optional = true }

# RUMA - Matrix protocol types
ruma = { version = "0.14", features = [
    "client-api-c",
    "appservice-api-c",
    "federation-api-c",
    "canonical-json",
    "rand",
], optional = true }

# Web server for appservice
salvo = "1.0.1"

[dev-dependencies]
tokio-test = "0.4"
wiremock = "0.6"
pretty_assertions = "1"
tempfile = "3"
mockito = "1"

[features]
default = []
storage-sqlite = ["rusqlite"]
storage-postgres = ["tokio-postgres"]
appservice = []
e2ee = []  # Placeholder - use CryptoClient with fallback encryption
ruma-types = ["ruma"]

[workspace]
members = ["."]
